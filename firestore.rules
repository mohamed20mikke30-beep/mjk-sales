rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeProfile(profile) {
      return profile.role in ['admin', 'agent']
        && (!('status' in profile) || profile.status in ['active', 'approved']);
    }

    function companyMember(companyId) {
      return signedIn()
        && userProfile().companyId == companyId
        && activeProfile(userProfile());
    }

    function companyAdmin(companyId) {
      return companyMember(companyId) && userProfile().role == 'admin';
    }

    function companyAgent(companyId) {
      return companyMember(companyId) && userProfile().role == 'agent';
    }

    function assignedToCaller(lead) {
      return lead.assignedTo == request.auth.uid
        || ('email' in request.auth.token && lead.assignedTo == request.auth.token.email);
    }

    function canAccessLead(companyId, leadId) {
      let lead = get(/databases/$(database)/documents/companies/$(companyId)/leads/$(leadId)).data;
      return companyMember(companyId)
        && lead.companyId == companyId
        && (companyAdmin(companyId) || assignedToCaller(lead));
    }

    match /users/{userId} {
      allow get: if signedIn()
        && (request.auth.uid == userId || companyAdmin(resource.data.companyId));
      allow list: if signedIn() && companyAdmin(resource.data.companyId);
      allow create, update: if false;
      allow delete: if false;

      match /records/{recordId} {
        function ownActiveUser() {
          return signedIn()
            && request.auth.uid == userId
            && activeProfile(userProfile());
        }

        function employeeRecord(data) {
          return data.recordKind in ['appointments', 'customScripts'];
        }

        allow read: if ownActiveUser()
          && (userProfile().role == 'admin' || employeeRecord(resource.data));
        allow create: if ownActiveUser()
          && (userProfile().role == 'admin' || employeeRecord(request.resource.data));
        allow update: if ownActiveUser()
          && (userProfile().role == 'admin' || (
            employeeRecord(resource.data) && employeeRecord(request.resource.data)
          ));
        allow delete: if ownActiveUser()
          && (userProfile().role == 'admin' || employeeRecord(resource.data));
      }
    }

    match /companies/{companyId}/leads/{leadId} {
      allow read: if companyMember(companyId)
        && resource.data.companyId == companyId
        && (companyAdmin(companyId) || assignedToCaller(resource.data));

      allow create: if companyMember(companyId)
        && request.resource.data.companyId == companyId
        && (companyAdmin(companyId)
          || (companyAgent(companyId) && assignedToCaller(request.resource.data)));

      allow update: if companyMember(companyId)
        && resource.data.companyId == companyId
        && request.resource.data.companyId == companyId
        && (companyAdmin(companyId)
          || (companyAgent(companyId)
            && assignedToCaller(resource.data)
            && assignedToCaller(request.resource.data)
            && request.resource.data.assignedTo == resource.data.assignedTo));

      allow delete: if false;

      match /actions/{actionId} {
        allow read: if canAccessLead(companyId, leadId);
        allow create: if canAccessLead(companyId, leadId)
          && request.resource.data.companyId == companyId
          && request.resource.data.leadId == leadId
          && (companyAdmin(companyId) || request.resource.data.agentId == request.auth.uid);
        allow update, delete: if false;
      }
    }

    match /companies/{companyId}/companySettings/{settingId} {
      allow read: if settingId == 'features' && companyMember(companyId);
      allow create, update: if settingId == 'features' && companyAdmin(companyId)
        && request.resource.data.keys().hasOnly([
          'features',
          'whatsappTemplate',
          'emailSubject',
          'emailTemplate',
          'metaWebhookUrl',
          'metaFieldMapping'
        ])
        && request.resource.data.features is map
        && request.resource.data.features.keys().hasOnly([
          'whatsapp',
          'metaLeadAds',
          'voip',
          'invoicing',
          'emailAutomation',
          'advancedAnalytics'
        ])
        && request.resource.data.features.whatsapp is bool
        && request.resource.data.features.metaLeadAds is bool
        && request.resource.data.features.voip is bool
        && request.resource.data.features.invoicing is bool
        && request.resource.data.features.emailAutomation is bool
        && request.resource.data.features.advancedAnalytics is bool
        && request.resource.data.whatsappTemplate is string
        && request.resource.data.emailSubject is string
        && request.resource.data.emailTemplate is string
        && request.resource.data.metaWebhookUrl is string
        && request.resource.data.metaFieldMapping is map
        && request.resource.data.metaFieldMapping.keys().hasOnly([
          'name',
          'phone',
          'email',
          'company',
          'jobTitle',
          'location',
          'project'
        ]);
      allow delete: if false;
    }

    match /employeeCredentials/{emailKey}/members/{memberId} {
      allow read, write: if false;
    }

    match /authRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /employeeCredentialLocks/{emailKey} {
      allow read, write: if false;
    }

    match /employeePasswordIndex/{fingerprint} {
      allow read, write: if false;
    }
  }
}
